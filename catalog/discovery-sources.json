      "role": "bulk-repository-discovery",
      "accessPolicy": "api-metadata-and-public-repositories",
      "expectedYield": "very-high",
      "notes": [
        "Partition searches by date, stars, and topics; verify manifests after discovery."
      ]
    },
    {
      "id": "software-heritage-graph",
      "label": "Software Heritage Graph Dataset",
