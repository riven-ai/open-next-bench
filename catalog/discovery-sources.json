{
  "$schema": "../schemas/discovery-sources.schema.json",
  "sources": [
    {
      "id": "vercel-templates",
      "label": "Vercel Next.js Templates",
      "url": "https://vercel.com/templates/next.js",
      "tier": 1,
      "role": "template-index",
      "accessPolicy": "resolve-public-repositories",
      "expectedYield": "high",
      "notes": [
        "Resolve each listing to a canonical repository and review its license independently."
      ]
    },
    {
      "id": "github-topic-template",
      "label": "GitHub topic: nextjs-template",
      "url": "https://github.com/topics/nextjs-template",
      "tier": 1,
      "role": "repository-discovery",
      "accessPolicy": "metadata-and-public-repositories",
      "expectedYield": "high",
      "notes": [
        "Topic membership is a discovery signal, not proof that a project uses Next.js."
      ]
    },
    {
      "id": "github-topic-starter",
      "label": "GitHub topic: nextjs-starter",
      "url": "https://github.com/topics/nextjs-starter",
      "tier": 1,
      "role": "repository-discovery",
      "accessPolicy": "metadata-and-public-repositories",
      "expectedYield": "high",
      "notes": ["Verify package manifests and deduplicate forks before intake."]
    },
    {
      "id": "github-topic-boilerplate",
      "label": "GitHub topic: nextjs-boilerplate",
      "url": "https://github.com/topics/nextjs-boilerplate",
      "tier": 1,
      "role": "repository-discovery",
      "accessPolicy": "metadata-and-public-repositories",
      "expectedYield": "high",
      "notes": [
        "Useful for production-oriented foundations; template forks require clustering."
      ]
    },
    {
      "id": "starterindex-nextjs",
      "label": "StarterIndex Next.js boilerplates",
      "url": "https://starterindex.com/github%2Bnextjs-boilerplates",
      "tier": 1,
      "role": "template-index",
      "accessPolicy": "resolve-public-repositories",
      "expectedYield": "medium",
      "notes": [
        "Treat indexed counts as discovery estimates until canonical repositories are resolved."
      ]
    },
    {
      "id": "nextjstemplates",
      "label": "Next.js Templates",
      "url": "https://nextjstemplates.com/",
      "tier": 1,
      "role": "template-index",
      "accessPolicy": "free-public-source-only",
      "expectedYield": "medium",
      "notes": [
        "Mixed free and paid catalog; never ingest paid source without explicit rights."
      ]
    },
    {
      "id": "netlify-nextjs",
      "label": "Netlify Next.js",
      "url": "https://www.netlify.com/with/nextjs/",
