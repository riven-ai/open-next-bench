{
  "name": "open-next-bench",
  "version": "0.1.0",
  "private": true,
  "description": "A reproducible benchmark for evaluating AI coding agents on real-world Next.js applications.",
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "yarn@4.9.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "baseline:repair": "tsx src/cli.ts run-repair-baselines",
    "check": "yarn format:check && yarn lint && yarn typecheck && yarn test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "score": "tsx src/cli.ts score",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "commander": "^14.0.0",
    "zod": "^4.0.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "@types/node": "^24.0.14",
    "eslint": "^9.31.0",
    "prettier": "^3.6.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.37.0",
    "vitest": "^3.2.4"
  }
}
