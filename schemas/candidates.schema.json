{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://open-next-bench.dev/schemas/candidates.schema.json",
  "title": "Open Next Bench candidate catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "repository", "status", "reason", "reviewNotes"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "repository": { "type": "string", "format": "uri" },
          "status": {
            "enum": ["proposed", "reviewing", "accepted", "rejected"]
          },
          "reason": { "type": "string", "minLength": 1 },
          "reviewNotes": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
